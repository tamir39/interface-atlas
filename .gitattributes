* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.png binary

# Preserve recorded evidence and upstream license bytes across platforms.
examples/skill-evaluation/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
examples/reference-craft-evaluation/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
examples/implementation-evaluation/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
references/licenses/*.txt -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
